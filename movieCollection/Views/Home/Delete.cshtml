

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Movie

<h2>Are you sure you want to delete this movie record?</h2>
<h3>@Model.Title </h3>

<form method="post">
    
    <input type="hidden" asp-for="MovieId"> <!-- makes it so that the controller can know which movie id we are deleting -->
    
    <button type="submit">Delete</button>
    <a class="btn btn info" asp-controller="Home" asp-action="Collection">Cancel</a>
</form>