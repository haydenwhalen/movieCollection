@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<Movie>

<table class="table table-bordered">
    <thead class = "fw-bold">
    <tr>
        <th>Category</th>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Lent To</th>
        <th>Notes</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Category.CategoryName</td>
            <td>@m.Title</td>
            <td>@m.Year</td>
            <td>@m.Director</td>
            <td>@m.Rating</td>
            <td>@m.Edited</td>
            <td>@m.LentTo</td>
            <td>@m.Notes</td>

            <td><a class="btn btn-info" asp-controller="Home" asp-action="Edit" asp-route-wallace ="@m.MovieId">Edit</a></td>   <!-- asp route wallace makes it so there's an ID to use when you want to edit or delete a record (so it knows which one to grab to edit / delete), wallace comes from bottom line in program.cs. -->
            <td><a class="btn btn-danger" asp-controller="Home" asp-action="Delete" asp-route-wallace ="@m.MovieId">Delete</a></td>
        </tr>
    }
    </tbody>
</table>
