@model movieCollection.Models.Movie

@{
   Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Movie Form</h1>
<br/>
<p>Use this form to add your favorite movie to the database</p>

<div class="container mt-5">
   <h1>Movie Form</h1>
   <form asp-action="movieForm" method="post">
       <input type="hidden" asp-for="MovieId" />


    <!-- Category Field -->
       <div class="mb-3">
           <label asp-for="CategoryId" class="form-label">Category</label>
           <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required>
               <option value="0">--Select Category--</option>
           </select>

           <span asp-validation-for="CategoryId" class="text-danger"></span>
       </div>



       <!-- Title Field -->
       <div class="mb-3">
           <label asp-for="Title" class="form-label">Title</label>
           <input asp-for="Title" class="form-control" required />
           <span asp-validation-for="Title" class="text-danger"></span>
       </div>

       <!-- Year Field -->
       <div class="mb-3">
           <label asp-for="Year" class="form-label">Year</label>
           <input asp-for="Year" class="form-control" required />
           <span asp-validation-for="Year" class="text-danger"></span>
       </div>

       <!-- Director Field -->
       <div class="mb-3">
           <label asp-for="Director" class="form-label">Director</label>
           <input asp-for="Director" class="form-control" required />
           <span asp-validation-for="Director" class="text-danger"></span>
       </div>

       <!-- Rating Field (Dropdown) -->
       <div class="mb-3">
           <label asp-for="Rating" class="form-label">Rating</label>
           <select asp-for="Rating" class="form-select" required>
               <option value="">--Select Rating--</option>
               <option value="G">G</option>
               <option value="PG">PG</option>
               <option value="PG-13">PG-13</option>
               <option value="R">R</option>
           </select>
           <span asp-validation-for="Rating" class="text-danger"></span>
       </div>

       <!-- Edited Field (Dropdown for Yes/No) -->
       <div class="mb-3">
           <label asp-for="Edited" class="form-label">Edited</label>
           <select asp-for="Edited" class="form-select">
               <option value="">--Select Option--</option>
               <option value="true">Yes</option>
               <option value="false">No</option>
           </select>
           <span asp-validation-for="Edited" class="text-danger"></span>
       </div>

       <!-- Lent To Field -->
       <div class="mb-3">
           <label asp-for="LentTo" class="form-label">Lent To</label>
           <input asp-for="LentTo" class="form-control" />
           <span asp-validation-for="LentTo" class="text-danger"></span>
       </div>

       <!-- Notes Field (Limited to 25 characters) -->
       <div class="mb-3">
           <label asp-for="Notes" class="form-label">Notes</label>
           <input asp-for="Notes" class="form-control" maxlength="25" />
           <span asp-validation-for="Notes" class="text-danger"></span>
       </div>

       <!-- Submit Button -->
       <button type="submit" class="btn btn-primary">Submit</button>
       <div asp-validation-summary="All"></div> <!-- PRINTS OUT ERROR MESSAGE FOR ANYTHING WRONG IN MODEL -->
   </form>
</div>






